# BigWigs packager settings (see docs/ADDON.md). The packager runs with addon/KeystoneLens as its top directory.
package-as: KeystoneLens

# The weekly data (scripts/build-addon-data.js) is copied in as KeystoneLens/KeystoneLens_DB by the
# Addon workflow and becomes its own folder in the zip, next to KeystoneLens. Without it, nothing moves.
move-folders:
  KeystoneLens/KeystoneLens_DB: KeystoneLens_DB

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .release
